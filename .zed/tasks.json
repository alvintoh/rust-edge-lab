[
  {
    "label": "rustlings: test this exercise",
    "command": "cargo",
    "args": ["test", "--manifest-path", "rustlings/Cargo.toml", "--bin", "$ZED_STEM"],
    "tags": ["rust-mod-test"],
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "rust: fix and format",
    "command": "cargo fix --workspace --allow-dirty --allow-staged && cargo fmt --all",
    "reveal": "always",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  }
]
